# Core
APP_ENV=development
SITE_URL=http://localhost:5010
SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters

# Demo / pilot data
# Keep disabled in production. Enable only for explicit demo environments.
DEMO_DATA_ENABLED=0

# Database
DATABASE_PATH=data/blacksea_owner.db

# Stripe (test-mode examples only; obtain values from the Stripe test dashboard)
STRIPE_MODE=test
STRIPE_CONNECT_ENABLED=0
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
MANUAL_FINANCE_ENABLED=1

# Security
TRUST_PROXY_HEADERS=0
# Optional trusted reverse-proxy/CDN country header.
# Example values depend on the deployment provider.
TRUSTED_COUNTRY_HEADER=

SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Logging
LOG_LEVEL=INFO

# Transactional email (required for owner magic links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Search engine ownership verification (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Deployment
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# AI service-request triage

AI_SERVICE_REQUEST_TRIAGE_ENABLED=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=60


# Production checklist
# APP_ENV=production
# SITE_URL=https://your-production-domain.example
# SECRET_KEY=<random value of at least 32 characters>
# SESSION_COOKIE_SECURE=1
# DEMO_DATA_ENABLED=0
# Configure SMTP_* before enabling owner magic-link login.
# Keep Stripe in test/manual mode until live payments are intentionally enabled.
